{
  "name": "@selfcure/cli",
  "version": "0.1.0",
  "description": "CLI entry-point for selfcure (init, crawl, run, heal, report)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "selfcure": "dist/index.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "latest",
    "@selfcure/analyzer": "*",
    "@selfcure/crawler": "*",
    "@selfcure/generator": "*",
    "@selfcure/reporter": "*",
    "@selfcure/runner": "*",
    "@selfcure/selfcure": "*",
    "@selfcure/web": "*",
    "chalk": "latest",
    "commander": "latest",
    "ora": "latest"
  }
}
