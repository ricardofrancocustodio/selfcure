{
  "name": "@selfcure/crawler",
  "version": "0.1.1",
  "description": "Static + dynamic source crawler — extracts component ASTs via @typescript-eslint/parser",
  "type": "module",
  "license": "MIT",
  "author": "ricardofrancocustodio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardofrancocustodio/selfcure.git",
    "directory": "packages/crawler"
  },
  "homepage": "https://github.com/ricardofrancocustodio/selfcure#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.59.4",
    "fs-extra": "^11.3.5",
    "glob": "^13.0.6",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4"
  }
}
