{
  "name": "@selfcure/reporter",
  "version": "0.1.1",
  "description": "Generates HTML report with test evidence — screenshots, traces, diffs",
  "type": "module",
  "license": "MIT",
  "author": "ricardofrancocustodio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardofrancocustodio/selfcure.git",
    "directory": "packages/reporter"
  },
  "homepage": "https://github.com/ricardofrancocustodio/selfcure#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@selfcure/runner": "^0.1.1",
    "@selfcure/selfcure": "^0.1.1",
    "chalk": "^5.6.2",
    "fs-extra": "^11.3.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4"
  }
}
